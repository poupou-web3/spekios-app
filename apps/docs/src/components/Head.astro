---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { settings } from '../../scripts/site.mjs';
const { entry } = Astro.locals.starlightRoute;
const path = Astro.url.pathname.slice(settings.base.length);
const canonical = settings.absolute(path);
const markdown = settings.absolute(path + 'index.md');
const is404 = entry.id === '404';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': settings.absolute() + '#website', name: 'Spekios documentation', url: settings.absolute(), inLanguage: 'en' },
    {
      '@type': 'TechArticle', '@id': canonical + '#article', headline: entry.data.hero?.title || entry.data.title,
      description: entry.data.description, url: canonical, inLanguage: 'en',
      ...(entry.data.reviewed ? { dateModified: entry.data.reviewed } : {}),
      isPartOf: { '@id': settings.absolute() + '#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Documentation', item: settings.absolute() },
        ...(path ? [{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical }] : []),
      ],
    },
  ],
};
---
<DefaultHead />
{!is404 && <>
  <link rel="alternate" type="text/markdown" href={markdown} title={entry.data.title + ' (Markdown)'} />
  <link rel="describedby" type="text/plain" href={settings.absolute('llms.txt')} />
  <meta property="og:site_name" content="Spekios documentation" />
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</>}
