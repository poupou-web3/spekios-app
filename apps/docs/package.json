{
  "name": "@scout/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "prepare:docs": "node scripts/prepare.mjs",
    "dev": "npm run prepare:docs && node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "npm run prepare:docs && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "npm run prepare:docs && node scripts/astro.mjs check",
    "test": "node --test scripts/*.test.mjs",
    "test:deployments": "node scripts/verify-deployments.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.4",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
