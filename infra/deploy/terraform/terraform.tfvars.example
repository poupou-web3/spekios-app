# Copy to terraform.tfvars (gitignored) and adjust.
# Tokens are NOT set here: export HCLOUD_TOKEN and CLOUDFLARE_API_TOKEN instead.

# Your public address(es) for SSH. Find yours with: curl -4 https://ifconfig.me
# ["0.0.0.0/0", "::/0"] opens SSH to everyone (key-only login).
admin_cidrs = ["203.0.113.7/32"]

# Who may pass Cloudflare Access on https://bo.spekios.com (one-time PIN by email).
# [] lets any email through; the console still asks for the operator token.
backoffice_allowed_emails = ["you@example.com"]

# ssh_public_key_path = "~/.ssh/spekios_hetzner.pub"   # create: ssh-keygen -t ed25519 -f ~/.ssh/spekios_hetzner
# image               = "debian-13"
# server_type         = "cx43"   # 8 vCPU / 16 GB; cx53 = 16 vCPU / 32 GB
# location            = "nbg1"   # nbg1, fsn1 or hel1
# server_backups      = true
# cloudflare_zone     = "spekios.com"
# app_subdomain       = "app"
# manage_ssl_rule     = true      # false if the zone already has a Configuration Rules ruleset
