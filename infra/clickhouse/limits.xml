<clickhouse>
  <!-- Inside the container only; Compose publishes HTTP on host loopback. -->
  <listen_host replace="replace">0.0.0.0</listen_host>
  <max_server_memory_usage>1400000000</max_server_memory_usage>
  <max_thread_pool_size>512</max_thread_pool_size>
  <background_pool_size>4</background_pool_size>
  <background_schedule_pool_size>4</background_schedule_pool_size>
  <background_message_broker_schedule_pool_size>2</background_message_broker_schedule_pool_size>
  <background_distributed_schedule_pool_size>2</background_distributed_schedule_pool_size>
  <merge_tree>
    <!-- Wide internal metric-log rows exceeded the local memory budget during
         merges and starved Spekios inserts. Retain all rows with smaller blocks. -->
    <merge_max_block_size>128</merge_max_block_size>
    <merge_max_block_size_bytes>1048576</merge_max_block_size_bytes>
    <!-- Small but very wide metric-log parts also need column-wise merging;
         their row count is below ClickHouse's usual vertical-merge threshold. -->
    <vertical_merge_algorithm_min_rows_to_activate>1</vertical_merge_algorithm_min_rows_to_activate>
    <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
  </merge_tree>
</clickhouse>
