# Created with independent random secrets by: node scripts/setup-local.mjs
# Never commit the resulting .env. Back it up securely alongside the volumes.
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLICKHOUSE_PASSWORD=
SCOUT_API_TOKEN=
# Skip workspace token entry on literal localhost origins during development.
# Leave disabled for non-development use; Compose publishes the API on loopback.
SCOUT_DEV_AUTH_BYPASS=false
# Optional provider API keys. These are read only by the Rust gateway.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Meta Model API bearer token. Meta's docs call this value MODEL_API_KEY.
# If META_API_KEY is empty, the gateway uses MODEL_API_KEY.
META_API_KEY=
MODEL_API_KEY=
# Exploration defaults; each launch still needs only a URL.
SCOUT_EXPLORER_PROVIDER=openrouter
SCOUT_EXPLORER_MODEL=openrouter/free
SCOUT_EXPLORER_FREE_ONLY=true
# 1–50 executed actions per run, including navigation and returns.
SCOUT_EXPLORER_MAX_ACTIONS=20
# Wall-clock stop for one exploration attempt (1–180 minutes). An interrupted
# exploration can continue in a new run; each attempt gets this limit.
SCOUT_EXPLORER_MAX_MINUTES=30
# Remember explored pages/controls across runs of the same app, viewport and sign-in state.
SCOUT_EXPLORER_APP_MEMORY=true
SCOUT_EXPLORER_VIEWPORT=desktop
# Optional automatic replay of suspects after exploration; each launch may override.
SCOUT_AUTO_REPRODUCE=false
SCOUT_AUTO_REPRODUCE_MAX_CASES=2
SCOUT_AUTO_REPRODUCE_MAX_ACTIONS=12
# Public https sites can be tested without an entry here.
# List private, HTTP and internal origins, including the bundled fixture.
SCOUT_ALLOWED_ORIGINS=http://exploration-fixture:8082
# Target sites run in the browser-sandbox containers. Keep Chromium's own sandbox
# on unless Chromium cannot start it on this host.
SCOUT_CHROMIUM_SANDBOX=true
# How many fresh browsers can run at once. Compose starts this many sandbox
# containers; each one serves a single run and then restarts. Integer 1–8.
SCOUT_BROWSER_SLOTS=3

# Optional exact form permissions for disposable test apps. Default: no write forms.
SCOUT_TEST_FORM_RULES=[]

# Optional browser approval behind a trusted HTTPS reverse proxy; preserve Host.
# Does not enable anonymous access or configure TLS/account signup.
SCOUT_PUBLIC_ORIGIN=
